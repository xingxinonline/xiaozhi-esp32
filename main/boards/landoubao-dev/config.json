{
    "target": "esp32s3",
    "builds": [
        {
            "name": "landoubao-dev",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_USE_BLE_WIFI_PROVISIONING=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_BLUEDROID_ENABLED=y",
                "CONFIG_BT_BLE_ENABLED=y",
                "CONFIG_BT_GATTS_ENABLE=y",
                "CONFIG_BT_BLE_BLUFI_ENABLE=y",
                "CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y",
                "CONFIG_MBEDTLS_DHM_C=y"
            ]
        },
        {
            "name": "landoubao-dev-joyinside",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_USE_JOYINSIDE_PROTOCOL=y",
                "CONFIG_USE_BLE_WIFI_PROVISIONING=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_BLUEDROID_ENABLED=y",
                "CONFIG_BT_BLE_ENABLED=y",
                "CONFIG_BT_GATTS_ENABLE=y",
                "CONFIG_BT_BLE_BLUFI_ENABLE=y",
                "CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y",
                "CONFIG_MBEDTLS_DHM_C=y"
            ]
        }
    ]
}